{
  "name": "ojp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:judge": "tsx --test tests/brainfuck.test.ts tests/judge-process.test.ts tests/judge-runtime.test.ts tests/judge-sandbox.test.ts",
    "test:ops": "node --test tests/judge-host-probe.test.mjs",
    "judge:doctor": "tsx scripts/judge-doctor.ts",
    "judge:probe": "node scripts/judge-host-probe.mjs",
    "judge:probe:heroku": "node scripts/judge-heroku-probe.mjs",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:down:volumes": "docker compose -f docker-compose.db.yml down -v",
    "db:generate": "node scripts/prisma-with-default-db-url.mjs generate",
    "db:push": "node scripts/prisma-with-default-db-url.mjs db push",
    "db:migrate:legacy-status": "node scripts/migrate-legacy-submission-status.mjs",
    "db:studio": "node scripts/prisma-with-default-db-url.mjs studio",
    "db:seed": "node scripts/prisma-with-default-db-url.mjs db seed",
    "db:prepare": "npm run db:up && npm run db:generate && npm run db:push && npm run db:seed",
    "worker:judge": "tsx scripts/judge-worker.ts",
    "template:problem-zip": "node scripts/create-problem-package-template.mjs",
    "predev": "node scripts/prepare-learning-runtime.mjs",
    "prebuild": "node scripts/prepare-learning-runtime.mjs",
    "db:learning": "node scripts/prisma-with-default-db-url.mjs db execute --schema prisma/schema.prisma --file prisma/learning-schema.sql",
    "test:learning": "tsx --test tests/learning.test.ts tests/learning-runner.test.ts tests/learning-storage.test.ts",
    "template:learning-zip": "tsx scripts/create-learning-template.ts",
    "test:learning:integration": "tsx --test tests/learning-store.integration.test.ts",
    "test:i18n": "tsx --test tests/i18n.test.ts",
    "test:i18n:http": "tsx --test tests/i18n-http.integration.test.ts",
    "test:contest": "tsx --test tests/contest.test.ts",
    "test:contest:integration": "tsx --test tests/contest-virtual.integration.test.ts tests/contest-http.integration.test.ts",
    "db:contest": "node scripts/prisma-with-default-db-url.mjs db execute --schema prisma/schema.prisma --file prisma/contest-schema.sql",
    "db:brainfuck": "node scripts/prisma-with-default-db-url.mjs db execute --schema prisma/schema.prisma --file prisma/brainfuck-schema.sql",
    "test:brainfuck": "tsx --test tests/brainfuck.test.ts tests/brainfuck-ui.test.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1008.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "6.12.2",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "^6.39.17",
    "@prisma/client": "^6.7.0",
    "@types/yauzl": "^2.10.3",
    "@uiw/react-codemirror": "^4.25.8",
    "adm-zip": "^0.5.16",
    "jszip": "^3.10.1",
    "katex": "^0.16.38",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pyodide": "0.27.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
